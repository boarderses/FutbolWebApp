37841>>>        Get HasRecord of hoDD to bHasRecord
37842>>>
37842>>>        // let's hide all buttons and then Show the ones we want
37842>>>        WebSet pbRender of oEditBtn to False
37843>>>        WebSet pbRender of oSaveBtn to False
37844>>>        WebSet pbRender of oCancelChangesBtn to False
37845>>>        WebSet pbRender of oDeleteBtn to False
37846>>>
37846>>>        If (NavigateData.bReadOnly) Begin
37848>>>            WebSet pbRender of oEditBtn to True
37849>>>        End
37849>>>>
37849>>>        Else Begin
37850>>>            WebSet pbRender of oSaveBtn to True
37851>>>            WebSet pbRender of oCancelChangesBtn to True
37852>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37853>>>        End
37853>>>>
37853>>>    End_Procedure
