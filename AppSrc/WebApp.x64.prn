37870>>>            Case (NavigateData.eNavigateType = nfFromParent)
37873>>>                // If from parent, this is a constrained drill down.
37873>>>                Case Break
37874>>>
37874>>>            Case (NavigateData.eNavigateType = nfFromChild)
37877>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37877>>>                Case Break
37878>>>
37878>>>            Case Else // must be nfUndefined
37878>>>
37878>>>        Case End
37878>>>
37878>>>        Send SetActionButtons
37879>>>
