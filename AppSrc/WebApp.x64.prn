39371>>>    Procedure SetActionButtons
39374>>>        tWebNavigateData NavigateData
39374>>>        tWebNavigateData NavigateData
39374>>>        Boolean bHasRecord
39374>>>        Handle hoDD
39374>>>
39374>>>        Get Server to hoDD
39375>>>        Get GetNavigateData to NavigateData
39376>>>        Get HasRecord of hoDD to bHasRecord
39377>>>
39377>>>        // let's hide all buttons and then Show the ones we want
39377>>>        WebSet pbRender of oEditBtn to False
39378>>>        WebSet pbRender of oSaveBtn to False
39379>>>        WebSet pbRender of oCancelChangesBtn to False
39380>>>        WebSet pbRender of oDeleteBtn to False
39381>>>
39381>>>        If (NavigateData.bReadOnly) Begin
39383>>>            WebSet pbRender of oEditBtn to True
39384>>>        End
39384>>>>
39384>>>        Else Begin
39385>>>            WebSet pbRender of oSaveBtn to True
39386>>>            WebSet pbRender of oCancelChangesBtn to True
39387>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39388>>>        End
39388>>>>
39388>>>    End_Procedure
