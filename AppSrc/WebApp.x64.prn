38383>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38383>>>                Case Break
38384>>>
38384>>>            Case Else // must be nfUndefined
38384>>>
38384>>>        Case End
38384>>>   
38384>>>        Send SetActionButtons
38385>>>
38385>>>    End_Procedure
