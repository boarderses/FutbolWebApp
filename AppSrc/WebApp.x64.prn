39548>>>        Get HasRecord of hoDD to bHasRecord
39549>>>
39549>>>        // let's hide all buttons and then Show the ones we want
39549>>>        WebSet pbRender of oEditBtn to False
39550>>>        WebSet pbRender of oSaveBtn to False
39551>>>        WebSet pbRender of oCancelChangesBtn to False
39552>>>        WebSet pbRender of oDeleteBtn to False
39553>>>
39553>>>        If (NavigateData.bReadOnly) Begin
39555>>>            WebSet pbRender of oEditBtn to True
39556>>>        End
39556>>>>
39556>>>        Else Begin
39557>>>            WebSet pbRender of oSaveBtn to True
39558>>>            WebSet pbRender of oCancelChangesBtn to True
39559>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39560>>>        End
39560>>>>
39560>>>    End_Procedure
