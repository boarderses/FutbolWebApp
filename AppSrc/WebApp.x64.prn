39643>>>        Procedure OnClick
39646>>>            
39646>>>            Integer iPosicion iJugador
39646>>>            Boolean bFound
39646>>>            
39646>>>            Get Field_Current_Value of oposicionesTotales_DD Field posicion.ID to iPosicion
39647>>>            Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugador
39648>>>            Send Clear of ojugadorposicion_DD
39649>>>            Move iPosicion to jugadorposicion.PosicionID
39650>>>            Move iJugador to jugadorposicion.JugadorID
39651>>>            Send Request_Find of ojugadorposicion_DD EQ jugadorposicion.File_Number 2
39652>>>            Move Found to bFound 
39653>>>            
39653>>>            If (bFound) Begin
39655>>>               Send ShowInfoBox "Ya tiene esa posición asignada"
39656>>>            End
39656>>>>
39656>>>            Else Begin
39657>>>                Send Clear of oposicion_DD
39658>>>                Move iPosicion to posicion.ID
39659>>>                Send Request_Find of oposicion_DD EQ posicion.File_Number 1
39660>>>                Move Found to bFound
39661>>>                
39661>>>                If (bFound) ;                    Send Request_Save of ojugadorposicion_DD
39664>>>                Else;                    Send ShowInfoBox "No existe la posicion seleccionada"
39666>>>            End
39666>>>>
39666>>>            
39666>>>            Send RefreshListFromDD of oList
39667>>>        End_Procedure
