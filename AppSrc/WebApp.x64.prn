38348>>>
38348>>>        // let's hide all buttons and then Show the ones we want
38348>>>        WebSet pbRender of oEditBtn to False
38349>>>        WebSet pbRender of oSaveBtn to False
38350>>>        WebSet pbRender of oCancelChangesBtn to False
38351>>>        WebSet pbRender of oDeleteBtn to False
38352>>>
38352>>>        If (NavigateData.bReadOnly) Begin
38354>>>            WebSet pbRender of oEditBtn to True
38355>>>        End
38355>>>>
38355>>>        Else Begin
38356>>>            WebSet pbRender of oSaveBtn to True
38357>>>            WebSet pbRender of oCancelChangesBtn to True
38358>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38359>>>        End
