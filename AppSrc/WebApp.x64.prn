37939>>>
37939>>>            Case (NavigateData.eNavigateType = nfFromParent)
37942>>>                // If from parent, this is a constrained drill down.
37942>>>                Case Break
37943>>>
37943>>>            Case (NavigateData.eNavigateType = nfFromChild)
37946>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37946>>>                Case Break
37947>>>
37947>>>            Case Else // must be nfUndefined
37947>>>
37947>>>        Case End
37947>>>
37947>>>        Send SetActionButtons
37948>>>
37948>>>    End_Procedure
