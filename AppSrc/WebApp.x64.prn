37846>>>        Get GetNavigateData to NavigateData
37847>>>        Get HasRecord of hoDD to bHasRecord
37848>>>
37848>>>        // let's hide all buttons and then Show the ones we want
37848>>>        WebSet pbRender of oEditBtn to False
37849>>>        WebSet pbRender of oSaveBtn to False
37850>>>        WebSet pbRender of oCancelChangesBtn to False
37851>>>        WebSet pbRender of oDeleteBtn to False
37852>>>
37852>>>        If (NavigateData.bReadOnly) Begin
37854>>>            WebSet pbRender of oEditBtn to True
37855>>>        End
37855>>>>
37855>>>        Else Begin
37856>>>            WebSet pbRender of oSaveBtn to True
37857>>>            WebSet pbRender of oCancelChangesBtn to True
37858>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37859>>>        End
37859>>>>
37859>>>    End_Procedure
