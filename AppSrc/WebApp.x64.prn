39024>>>    Procedure SetActionButtons
39027>>>        tWebNavigateData NavigateData
39027>>>        tWebNavigateData NavigateData
39027>>>        Boolean bHasRecord
39027>>>        Handle hoDD
39027>>>
39027>>>        Get Server to hoDD
39028>>>        Get GetNavigateData to NavigateData
39029>>>        Get HasRecord of hoDD to bHasRecord
39030>>>
39030>>>        // let's hide all buttons and then Show the ones we want
39030>>>        WebSet pbRender of oEditBtn to False
39031>>>        WebSet pbRender of oSaveBtn to False
39032>>>        WebSet pbRender of oCancelChangesBtn to False
39033>>>        WebSet pbRender of oDeleteBtn to False
39034>>>        WebSet pbRender of oEquiposBtn to True
39035>>>
39035>>>        If (NavigateData.bReadOnly) Begin
39037>>>            WebSet pbRender of oEditBtn to True
39038>>>        End
39038>>>>
39038>>>        Else Begin
39039>>>            WebSet pbRender of oSaveBtn to True
39040>>>            WebSet pbRender of oCancelChangesBtn to True
39041>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39042>>>        End
39042>>>>
39042>>>    End_Procedure
