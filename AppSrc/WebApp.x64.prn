37340>>>    Procedure DoLogin
37343>>>        String sLoginName sPassword sPrevStateHash
37343>>>        Boolean bResult
37343>>>        
37343>>>        WebGet psValue of oLoginName to sLoginName
37344>>>        WebGet psValue of oPassword to sPassword
37345>>>        
37345>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37346>>>        
37346>>>        If (bResult) Begin
37348>>>            Send Hide of oLogin
37349>>>            Send ShowHeader of ghoWebApp
37350>>>            WebSet psCSSClass of ghoWebApp to ""
37351>>>            
37351>>>            WebGet psPrevStateHash to sPrevStateHash
37352>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37353>>>            
37353>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37353>>>            WebSet psValue of oLoginName to ""
37354>>>            WebSet psValue of oPassword  to ""
37355>>>            WebSet pbVisible of oWarning to False
37356>>>        End
37356>>>>
37356>>>        Else Begin
37357>>>            WebSet pbVisible of oWarning to True
37358>>>        End
37358>>>>
37358>>>    End_Procedure
37359>>>    
37359>>>    Procedure OnSubmit
37362>>>        Send DoLogin
37363>>>    End_Procedure
37364>>>    
37364>>>    Procedure OnLoad
37367>>>        String sPrevStateHash sView
37367>>>        
37367>>>        Forward Send OnLoad
37369>>>        
37369>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37369>>>        Get StateHash of ghoWebApp to sPrevStateHash
37370>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37371>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37373>>>            WebSet psPrevStateHash to sPrevStateHash
37374>>>        End
37374>>>>
37374>>>        
37374>>>    End_Procedure
37375>>>    
37375>>>    Procedure OnBeforeShow
37378>>>        //  Hide header & apply nice background style
37378>>>        Send HideHeader to ghoWebApp
37379>>>        WebSet psCSSClass of ghoWebApp to "LoginBackground"
37380>>>    End_Procedure
37381>>>    
37381>>>End_Object
