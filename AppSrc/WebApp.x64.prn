37883>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37883>>>                Case Break
37884>>>
37884>>>            Case Else // must be nfUndefined
37884>>>
37884>>>        Case End
37884>>>
37884>>>        Send SetActionButtons
