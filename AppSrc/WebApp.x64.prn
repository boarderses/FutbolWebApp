39399>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39402>>>        Case Begin
39402>>>            Case (NavigateData.eNavigateType = nfFromMain)
39404>>>                // If from main, this is a propbably a main file Select to Zoom.
39404>>>                Case Break
39405>>>
39405>>>            Case (NavigateData.eNavigateType = nfFromParent)
39408>>>                // If from parent, this is a constrained drill down.
39408>>>                Case Break
39409>>>
39409>>>            Case (NavigateData.eNavigateType = nfFromChild)
39412>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39412>>>                Case Break
39413>>>
39413>>>            Case Else // must be nfUndefined
39413>>>
39413>>>        Case End
39413>>>
39413>>>        Send SetActionButtons
39414>>>
39414>>>    End_Procedure
